{
  "expo": {
    "name": "Zombie Tag",
    "slug": "zombie-tag",
    "version": "0.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f0a",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zombieoutbreak.game"
    },
    "android": {
      "package": "com.zombieoutbreak.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f0a"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "experiments": {
      "baseUrl": "/zombie-tag"
    },
    "extra": {
      "supportsRTL": false,
      "eas": {
        "projectId": "e0fbc474-0fdf-45cc-a79b-d994cfe35b7a"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "owner": "tamat2013",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/e0fbc474-0fdf-45cc-a79b-d994cfe35b7a",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
