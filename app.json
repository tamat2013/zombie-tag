{
  "expo": {
    "name": "Zombie Tag",
    "slug": "zombie-tag",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f0a",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zombieoutbreak.game"
    },
    "android": {
      "package": "com.zombieoutbreak.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f0a"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "experiments": {
      "baseUrl": "/zombie-tag"
    },
    "extra": {
      "supportsRTL": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ]
  }
}
