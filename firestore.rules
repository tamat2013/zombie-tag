rules_version = '2';
// Firestore security rules for the zombie game.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Player profiles: only the owner can read or write.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Custom maps: any signed-in player can read (needed for the community list and share codes),
    // only the author can create, change or delete.
    match /maps/{mapId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.tiles.size() <= 4000;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid
        && (request.method == 'delete' || request.resource.data.authorId == request.auth.uid);
    }

    // Global leaderboard: one public row per player. Everyone signed in can read; a player writes only
    // their own row, with exactly these fields, and the numbers can only go up.
    match /leaderboard/{uid} {
      function validRow() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'xp', 'wins', 'infections', 'tasks'])
          && d.uid == uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 30
          && d.xp is int && d.xp >= 0 && d.xp <= 10000000
          && d.wins is int && d.wins >= 0 && d.wins <= 10000000
          && d.infections is int && d.infections >= 0 && d.infections <= 10000000
          && d.tasks is int && d.tasks >= 0 && d.tasks <= 10000000;
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validRow();
      allow update: if signedIn() && request.auth.uid == uid && validRow()
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.infections >= resource.data.infections
        && request.resource.data.tasks >= resource.data.tasks;
    }

    // Tournament leaderboards: everyone signed in can read, players write only their own entry,
    // and a single write can add at most 2000 points.
    match /tournaments/{tournamentId}/entries/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points <= 2000;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 2000;
    }
  }
}
