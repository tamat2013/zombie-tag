{
  "name": "zombie-tag",
  "version": "0.1.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "expo start",
    "android": "node scripts/run-android.js",
    "android:offline": "node scripts/run-android.js --offline",
    "android:release": "node scripts/run-android.js --release",
    "web": "node scripts/run-web.js",
    "web:offline": "node scripts/run-web.js --offline",
    "web:build": "expo export --platform web",
    "desktop:build": "node scripts/build-desktop.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ios": "expo run:ios"
  },
  "build": {
    "appId": "com.zombieoutbreak.game",
    "productName": "Zombie Tag",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "directories": {
      "app": ".desktop-build/app",
      "output": "release-windows"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ZombieTag-Setup.${ext}",
      "icon": ".desktop-build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tamat2013",
        "repo": "zombie-tag"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": ".desktop-build/icon.ico",
      "uninstallerIcon": ".desktop-build/icon.ico",
      "installerHeaderIcon": ".desktop-build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo-google-fonts/rubik-wet-paint": "^0.4.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~54.0.12",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.20",
    "firebase": "^12.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "png-to-ico": "^3.0.2",
    "png-to-ico": "^3.0.2",
    "typescript": "~5.9.2"
  }
}
