{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'skin'])"
          }
        },
        "live": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('hostId').val() === auth.uid)"
          }
        }
      }
    }
  }
}
