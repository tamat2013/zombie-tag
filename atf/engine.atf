const AB_SPRINT = 0
const AB_SCAN = 1
const AB_MEDIC = 2
const AB_VANISH = 3
const AB_DASH = 4
const AB_ZVIS = 5
const AB_ROAR = 6
const AB_SMOKE = 7
const AB_TELEPORT = 8
const AB_FRENZY = 9
const AB_LEAP = 10
const AB_BUBBLE = 11
const AB_ADRENALINE = 12
const AB_FLASH = 13
const AB_CLOAK = 14
const AB_HOWL = 15
const AB_LUNGE = 16
const AB_RAGE = 17
const AB_SNIFF = 18

let ABILITIES = abilities()

// which effect an ability switches on (-1 = none)
fn effect_for(ab: int) -> int {
    return match ab {
        0 => E_SPRINT
        1 => E_SCAN
        3 => E_INVIS
        4 => E_DASH
        5 => E_VISION
        9 => E_FRENZY
        11 => E_SHIELD
        12 => E_SPRINT
        14 => E_INVIS
        17 => E_DASH
        18 => E_VISION
        _ => -1
    }
}

struct Skin {
    name: str
    body: int
    accent: int
    eyes: int        // 0 round, 1 angry, 2 sleepy, 3 cyclops
    pattern: int     // 0 none, 1 stripes, 2 spots, 3 split, 4 ring
    power: str
    info: str
}

