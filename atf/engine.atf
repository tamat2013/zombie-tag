// engine.atf - players, roles, abilities, infection, doctors, stones and the match rules of Zombie Tag.
// All times are seconds of game time (g.now).

import "world"

const SURVIVOR_SPEED = 170.0
const ZOMBIE_SPEED = 126.0
const SURVIVOR_VISION = 230.0
const ZOMBIE_VISION = 200.0
const INFECT_REACH = 4.0
const TASK_RANGE = 52.8
const MATCH_SEC = 600.0
const TRAIN_SEC = 300.0
const TASK_BONUS = 15.0
const FREEZE_SEC = 10.0
const HEAL_REACH = 10.0
const STONE_RANGE = 288.0
const NOISE_SEC = 5.0
const NOISE_HEAR = 560.0
const SOUND_WAVE = 300.0
const MUD_SLOW = 0.55
const SAW_PERIOD = 2.6

const SURV = 0
const ZOMB = 1

// effects
const E_SPRINT = 0
const E_SHIELD = 1
const E_SCAN = 2
const E_INVIS = 3
const E_DASH = 4
const E_VISION = 5
const E_SLOWED = 6
const E_FRENZY = 7
const E_BLIND = 8

// modes of a match
const M_CLASSIC = 0
const M_TRAIN = 1
const M_OBSTACLE = 2

// bot modes
const B_IDLE = 0
const B_TASK = 1
const B_WORK = 2
const B_FLEE = 3
const B_CHASE = 4
const B_HUNT = 5
const B_WANDER = 6

struct Ability {
    name: str
    short: str
    role: int
    cd: float
    dur: float
    radius: float
    info: str
}

