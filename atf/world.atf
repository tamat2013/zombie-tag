// A generated map: rooms joined by corridors, with crates, mud, tasks and spawns (seeded, so it is always the same).
fn generate_rows(seed: int, w: int, h: int, mud: float) -> [str] {
    rand_seed(seed)
    var g: [[str]] = []
    for y in 0..h {
        var row: [str] = []
        for x in 0..w { row.push("#") }
        g.push(row)
    }
    var rooms: [[int]] = []
    for _ in 0..(w * h / 90) {
        let rw = rand_int(5, 11)
        let rh = rand_int(4, 8)
        let rx = rand_int(2, w - rw - 2)
        let ry = rand_int(2, h - rh - 2)
        var ok = true
        for r in rooms {
            if rx < r[0] + r[2] + 2 and rx + rw + 2 > r[0] and ry < r[1] + r[3] + 2 and ry + rh + 2 > r[1] { ok = false }
        }
        if not ok { continue }
        rooms.push([rx, ry, rw, rh])
        for y in ry..(ry + rh) {
            for x in rx..(rx + rw) { g[y][x] = "." }
        }
    }
    for i in 1..rooms.len() {
        let a = rooms[i - 1]
        let b = rooms[i]
        carve(g, a[0] + a[2] / 2, a[1] + a[3] / 2, b[0] + b[2] / 2, b[1] + b[3] / 2)
        if i % 3 == 0 and i > 2 {
            let c = rooms[i - 3]
            carve(g, c[0] + c[2] / 2, c[1] + c[3] / 2, b[0] + b[2] / 2, b[1] + b[3] / 2)
        }
    }
    for i in 0..rooms.len() {
        let r = rooms[i]
        if i % 4 == 0 and i > 0 { g[r[1] + 1][r[0] + 1] = "S" }
        if i % 4 == 2 { g[r[1] + r[3] - 2][r[0] + r[2] - 2] = "Z" }
        if g[r[1]][r[0]] == "." { g[r[1]][r[0]] = "T" }
        if i % 2 == 1 and r[2] > 6 { g[r[1] + r[3] / 2][r[0] + r[2] / 2] = "C" }
        if rand_float() < mud {
            for y in (r[1] + 1)..(r[1] + r[3] - 1) {
                for x in (r[0] + 2)..(r[0] + r[2] - 2) {
                    if g[y][x] == "." { g[y][x] = "~" }
                }
            }
        }
    }
    if rooms.len() > 0 {
        let f = rooms[0]
        g[f[1] + f[3] / 2][f[0] + 1] = "S"
        let l = rooms[rooms.len() - 1]
        g[l[1] + l[3] / 2][l[0] + l[2] - 2] = "Z"
    }
    var out: [str] = []
    for row in g { out.push("".join(row)) }
    return out
}

fn carve(g: [[str]], x0: int, y0: int, x1: int, y1: int) {
    var x = x0
    var y = y0
    while x != x1 {
        if g[y][x] == "#" { g[y][x] = "." }
        if x < x1 { x += 1 } else { x -= 1 }
    }
    while y != y1 {
        if g[y][x] == "#" { g[y][x] = "." }
        if y < y1 { y += 1 } else { y -= 1 }
    }
    if g[y][x] == "#" { g[y][x] = "." }
}

fn all_maps() -> [GMap] {
    return [
        map_from_rows("hospital", "Abandoned Hospital", scale_rows(HOSPITAL, 2), false, []),
        map_from_rows("mall", "Dead Mall", scale_rows(MALL, 2), false, []),
        map_from_rows("base", "Army Camp", scale_rows(BASE, 2), false, []),
        map_from_rows("lab", "Secret Lab", generate_rows(11, 64, 40, 0.15), false, []),
        map_from_rows("prison", "Max Security Prison", generate_rows(23, 72, 44, 0.1), false, []),
        map_from_rows("swamp", "Swamp Village", generate_rows(197, 72, 48, 0.8), false, []),
        map_from_rows("obstacle_rookie", "Rookie Course", OB_ROOKIE, true, [30, 45, 70]),
        map_from_rows("obstacle_saw", "Saw Valley", OB_SAW, true, [35, 55, 80]),
        map_from_rows("obstacle_marsh", "Mud Marsh", OB_MARSH, true, [45, 65, 95]),
        map_from_rows("obstacle_gauntlet", "Saw Gauntlet", OB_GAUNTLET, true, [45, 65, 95]),
    ]
}
