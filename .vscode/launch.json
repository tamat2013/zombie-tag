{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "אנדרואיד - משחק מלא (עם Firebase)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node scripts/run-android.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "setup",
      "env": { "EXPO_PUBLIC_OFFLINE": "", "PATH": "${env:PATH};${env:ProgramFiles}\\nodejs" }
    },
    {
      "name": "אנדרואיד - בלי Firebase (אופליין + בוטים)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node scripts/run-android.js --offline",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "setup",
      "env": { "PATH": "${env:PATH};${env:ProgramFiles}\\nodejs" }
    }
  ]
}
